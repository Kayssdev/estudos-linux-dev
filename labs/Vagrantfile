# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.boot_timeout = 600

  config.vm.provider "virtualbox" do |vb|
    vb.gui = false      # headless — acesse via vagrant ssh
    vb.memory = "2048"  # 2GB recomendado para Ubuntu 24.04
  end

  # Rede — descomente para criar uma rede privada com IP fixo:
  config.vm.network "private_network", ip: "192.168.33.10"

  # Portas — descomente para encaminhar uma porta do host para a VM:
  # config.vm.network "forwarded_port", guest: 80, host: 8080
config.ssh.insert_key = false
  # Provisionamento — descomente para rodar comandos ao subir a VM:
  # config.vm.provision "shell", inline: <<-SHELL
  #   apt-get update
  #   apt-get install -y nginx
  # SHELL
end
